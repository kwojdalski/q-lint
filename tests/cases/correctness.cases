=== QB001 | a qSQL filter comparing a column to itself
select from t where a=a

=== clean | comparing two different columns
select from t where a=b

=== QB002 | two wildcards, not a leading and trailing pair (q 5: "abc" like "a*b*" is 'nyi)
select from t where sym like "a*b*"

=== QB002 | or two together (q 5: 'nyi)
select from t where sym like "a**"

=== clean | one interior wildcard is supported in q 5 ("abc" like "a*c" is 1b)
select from t where sym like "a*b"

=== clean | as is a leading and trailing pair ("abc" like "*b*" is 1b)
select from t where sym like "*b*"

=== clean | a star in brackets is a literal ("a*c" like "*[*]*" is 1b)
select from t where sym like "*[*]*"

=== clean | a trailing wildcard is supported
select from t where sym like "ab*"

=== clean | two joined symbols are two strings, which sv joins as a path: "dir/name"
p:"/" sv string a,b

=== clean | sv over a list built elsewhere
p:"/" sv parts

=== QB005 | match in a filter compares whole vectors, not rows
select from t where sym~`x

=== clean | each-left match is the row-wise form
select from t where sym~/:`x

=== clean | equality in a filter is row-wise
select from t where sym=`x

=== QB006 | a comparison left of and reads as a=(1 and b=0)
select from t where a=1 and b=0

=== clean | parenthesised, the comparison is said out loud
select from t where (a=1) and b=0

=== clean | a comparison to the right of and is its operand
select from t where flag and b=0

=== clean | a comparison alone needs no parentheses
select from t where a=1

=== QB007 | like with a symbol pattern
select from t where sym like `a*

=== QB007 | a bare symbol pattern is 'type
r:"abc" like `abc

=== QB007 | and a glob after the symbol parses as an operator, a silent projection
r:"abc" like `a*

=== clean | like with a string pattern
select from t where sym like "a*"

=== QB008 | equality against a vector literal
select from t where px=1 2

=== QB008 | a symbol vector likewise
select from t where sym=`a`b

=== clean | in is the membership operator
select from t where px in 1 2

=== clean | equality against a scalar
select from t where px=1

=== clean | an empty select under by is the documented last-row-per-group idiom
select by sym from t

=== clean | a bare column under by is grouped into a list per group, which is what by is for
select px by sym from t

=== clean | an aggregated column under by
select first px by sym from t

=== clean | no by, no grouping trap
select px from t

=== clean | aliased, likewise
select last_px:px by sym from t

=== clean | a bracketed aggregate
select avg[px] by sym from t

=== clean | a user-defined aggregation
select .my.agg px by sym from t

=== QB010 | name, space, negative literal is application
r:a -1

=== QB010 | in a condition too
if[n -1;2]

=== QB010 | a temporal literal is the same trap
window_to:.z.p;r:window_to -0D00:01

=== QB010 | .z.p is a value, so applying it is never meant
r:0D00:01 xbar .z.p -0D00:01

=== QB010 | inside a conditional
r:$[null c; window_to -0D00:01; c]

=== QB010 | a time literal
r:t -00:00:01

=== clean | subtraction of a timespan, any spacing
r:.z.p - 0D00:01;r:.z.p-0D00:01;r:window_to - 0D00:01

=== clean | a namespaced name may be a function from elsewhere
r:.util.shift -1;r:.util.back -0D00:01

=== clean | in a comment or a string
/ r:.z.p -0D00:01
s:"window_to -0D00:01"

=== clean | subtraction, any spacing
r:a-1;r:a - 1;r:a- 1

=== clean | a builtin applied to a negative literal is meant
r:neg -1;r:abs -2

=== clean | so is a lambda the file defines
f:{x+1}
r:f -1

=== clean | a numeric literal on the left is a vector
r:1 2 -3

=== QB011 | if assigned as a value is null
x:if[a;1]

=== QB011 | while likewise
x:while[a;1]

=== clean | cond has a value
x:$[a;1;2]

=== clean | if as a statement
if[a;x:1]

=== QB012 | a trailing semicolon discards the last expression
f:{[x] x+1;}

=== QB012 | a bare name at the end likewise
f:{[x] r:x+1; r;}

=== clean | no trailing semicolon
f:{[x] x+1}

=== QF017 | an assignment at the end is not a discarded value, though nothing reads it
f:{[x] r:x+1;}

=== clean | a side-effecting call at the end
f:{[x] .lg.o[x];}

=== clean | a print at the end
f:{[x] -1 "done";}

=== QB013 | type compared to a symbol
if[type[x]=`long;1]

=== QB013 | symbol on the left
if[`long=type x;1]

=== clean | the symbols on the right are the start of a find
r:type[1]=`a`b?`a

=== QB013 | but a symbol vector that ends the comparison is still one
r:type[x]=`a`b;

=== clean | type compared to a short
if[type[x]=7h;1]

=== clean | a column named type is another rule's business
select from t where type=`a

=== QB014 | slash between literals is the over adverb
r:10/2

=== clean | the slashes of a file path are not the adverb
x:`:data/2024/01

=== QB014 | but a path beside a division still has one
x:(`:data/2024;10/2)

=== QB014 | after a parenthesised value too
r:(a+b)/2

=== clean | a bracketed projection with a left operand is over, as meant
mem:{(3#system"w")%x (1024*)/ 1}
p:(10000>pi::)(2*)/1000

=== QB014 | without the left operand q refuses it: (2*)/1 is '/
r:(2*)/1

=== clean | percent divides
r:10%2

=== clean | over on a function
r:+/1 2 3

=== QB015 | a string literal in a filter
select from t where sym="EUR"

=== QB015 | the empty string is no better
select from t where sym=""

=== clean | a one-char string is a char atom
select from t where c="a"

=== clean | like, match and in are the string comparisons
select from t where sym like "EUR", s~\:"ab", c in "abc"

=== QB016 | delete cannot take columns and a where phrase
delete a from t where b>3

=== QB016 | the table may be a literal
delete a from ([]a:1 2;b:3 4) where b>3

=== clean | a select after from takes the where phrase for itself
r:delete a from select from t where b>3

=== clean | columns alone
delete a from t

=== clean | a where phrase alone
delete from t where b>3

=== clean | a literal that continues into an expression is indexing on purpose
r:sizes -1+count sizes

=== clean | a side effect by juxtaposition at the end is not a discarded value
f:{[x] show x;}

=== clean | nor is an application of a lambda to a string
f:{[x] .lg.o "done";}

=== clean | the where phrase belongs to the inner select
r:delete ok from select from t where not ok

=== clean | the continued form is the same path join
p:"/" sv string
  dir,name

=== QB006 | the filter reads the same split across lines
t:select from t where
  a=1 and b=0

=== clean | at column 0 the second line is a separate statement
p:"/" sv string
dir:1

=== QB004 | a thrown message long enough to be truncated
f:{'"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}

=== clean | 254 characters survive whole in q 5
f:{'"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}

=== clean | a message short enough to survive
f:{'"too few rows"}

=== QB017 | a name assigned to itself
a:a

=== QB017 | and inside a lambda, where it usually is
f:{[x] b:1; b:b; b}

=== clean | a table column named after the variable filling it
t:([]time:time;msg:msg)

=== clean | one element assigned from another is not self-assignment
updmeta[`periodic]:updmeta[`singular]

=== clean | a function applied to the name is not either
res:(options`postprocessing)res

=== clean | rebinding through an expression
f:{[x] x:x+1; x}

=== QB018 | two literals compared
r:1=2

=== QB018 | symbols count as literals
r:`a=`b

=== clean | one side is a name
r:x=1

=== clean | fill continues the expression, so this is not two literals
r:0<0^x

=== clean | and neither is drop
r:0<1_deltas x

=== clean | -1_x is drop, not a negative literal
step:{if[hasvowel -1_x;x[-1+count x]:"i"];x}

=== clean | a column against an item of itself is not a self-comparison
r:select from t where c=c i

=== clean | a match inside a lambda applied to each row is per row
r:select from t where {x[`b]~2} each d

=== clean | -1_ is drop, so these compare against data, not two literals
r1:all 0=-1_es
r2:where (-1_r=0),0b

=== QB019 | a column named twice, which q 5 renames rather than refuses
t:([]a:1 2;a:3 4)

=== clean | a dictionary literal may repeat a key
d:([a:1;a:2])

=== QB020 | a statement after a top-level return never runs
f:{:1;2}

=== QB020 | nor after a signal
f:{'`e;x}

=== clean | a return inside a branch leaves the rest reachable
f1:{if[x;:1];2}
f2:{$[x;:1;2]}
f3:{x+1;:2}

=== clean | string x,() is how a list is made of what may be an atom
f:{.lg.o[`c;"types "," " sv string procs,()]}
g:{.lg.o[`c;"types "," " sv string procs,:()]}

=== clean | a comparison and an or in different comma-separated clauses
r:select from t where abs[port]=1,(lower[h]=x) or h=`a

=== clean | QB015: an `=` inside a string is not a comparison
f:{[t] select from t where a in `x, b like "="}

=== QB015 | and a real one after such a string is still found
f:{[t] select from t where b like "=", c<>"ab"}

=== QB003 | a string joined inside sv string is split into characters
m:"claimed by ",", " sv string clash," - two workers share it"

=== QB003 | after another joined name too
p:"/" sv string a,b,"xy"

=== clean | parenthesised, the string joins the result of sv
m:"claimed by ",(", " sv string clash)," - two workers share it"

=== clean | a one-character literal is one item: "dir/x"
p:"/" sv string a,"x"

=== clean | an empty literal adds nothing
p:"/" sv string a,""

=== clean | QT022: an integer atom applied is a file handle - 1 is stdout - not an atom indexed
out:1
out["hello"]

=== QT022 | a float atom indexed by juxtaposition, as with brackets
f:2.5
r:f 0

=== clean | QT022: an infix builtin after an atom is not indexing it
w:3.5
r:w msum 1 2 3

=== QA002 | a lambda without a parameter list takes x and y here, so three arguments are too many
r:{x+y}[1;2;3]

=== QA002 | and with no x, y or z read it still takes one
r:{1}[1;2]

=== clean | QA002: y read means two arguments
r:{y}[1;2]

=== clean | QA002: a nested lambda's arguments are its own
r:{x+{y}[1;2]}[1]

=== QT021 | an empty pattern written infix
r:"abc" ss ""

=== clean | QT021: a non-empty pattern infix
r:"abc" ss "b"

=== clean | QT022: a null integer is a handle not yet opened, written to by juxtaposition
log_handle:0N
f:{[msg] log_handle enlist msg}

=== clean | QA011: a spaced literal ending in b is an application, not a boolean vector
r:$[1 0b;`t;`f]

=== QA011 | the unspaced boolean vector is the one $ refuses
r:$[10b;`t;`f]

=== QT029 | a host:port symbol without the leading colon
h:hopen `localhost:5000

=== clean | QT029: with the leading colon it is a handle
h:hopen `:localhost:5000

=== QT010 | max of a symbol vector
r:max `a`b

=== clean | QT010: max of a symbol atom, or of a string, is fine
r:max `a
r2:max "ab"

=== clean | QT025: after `:` the quote is each on assignment, not a signal
r:'5

=== QT025 | a number signalled where a statement opens
f:{x;'5}

=== QB018 | a vector against an atom, quoted whole
r:1 2 3>2

