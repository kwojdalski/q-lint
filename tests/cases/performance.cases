=== QV001 | the partition column constrained after another (KDB-X, 20 date partitions: 85 ms against 5 ms with date first)
r:select from t where sym=`a, date=2024.01.05

=== QV001 | within, after a numeric comparison (56 ms against 12 ms)
r:select from t where size>500, date within 2024.01.05 2024.01.06

=== QV001 | month and year partitions, and exec
a:exec price from t where sym in `a`b, month=2024.01m
b:exec px from t where sym=s, year=2024

=== clean | update and delete: q refuses both on a partitioned table ('par in KDB-X), so the table is in memory
b:update x:1 from t where sym=s, year=2024
c:delete from t where px>1.5, date<2024.01.01
futures:update settle:settle+30f from futures where commodity=`SYNA, date>dMid

=== QV001 | an update over a select still reports the select
r:update x:1 from select from t where sym=`a, date=d

=== QV001 | a string literal before it
r:select from t where name like "ab*", date=2024.01.05

=== QV001 | a constraint in parentheses, either the late one or the one before it (#2741)
a:select from t where (sym=`a), date=d
b:select from t where sym=`a, (date=d)

=== QV001 | the column on the right, which q does not narrow by even when first (KDB-X, 12 date partitions: 45 ms, and 89 ms moved first as written, against 6 ms)
r:select from t where sym=`a, d=date
s:select from t where size>500, 2024.01.05<=date

=== clean | parentheses around part of a constraint are not around it, and a local named as the column is what the right may be
r:select from t where (sym=`a)or(size>500), date=d
s:select from t where sym=`a, (date=d)or(size>500)
f:{[date] select from t where sym=`a, tradeDate=date}
g:{month:2024.01m; select from t where sym=`a, tradeMonth=month}

=== clean | the partition column first
r:select from t where date=2024.01.05, sym=`a
s:select from t where date within (d0;d1), size>500

=== clean | an aggregate before it: moving date first changes the rows avg sees
r:select from t where price>avg price, date=2024.01.05

=== clean | the late constraint aggregates too: first, `max date` is over every row, not the rows the sym kept (KDB-X: one row against none, #2923)
r:select from t where sym=`b, date=max date
s:select from t where sym=`b, date=last date
u:select from t where sym=`b, date in -2#date
v:select from t where sym=`b, date=(max;date) fby sym
w:select from t where size>500, date>prev settle

=== QV001 | a late constraint that reads no row but its own
r:select from t where sym=`a, date=.z.d-1
s:select from t where sym=`a, date in .z.d-til 5
u:select from t where sym=`a, date within (sd;ed)

=== clean | a table literal or a query in parentheses is in memory, as update's table is (#2924)
a:select from ([] sym:`a`b; date:2020.01.01 2020.01.02) where sym=`a, date=2020.01.01
b:select from (select from t where date=2020.01.01) where sym=`a, date=2020.01.01
c:exec from ([]date:1#.z.d;sym:1#`a) where sym=`a, date=.z.d
d:select from ( [k:1 2] sym:`a`b; date:2#.z.d) where sym=`a, date=.z.d
e:select from (update x:1 from t) where sym=`a, date=.z.d

=== QV001 | a name in parentheses is still a table that may be partitioned
r:select from (t) where sym=`a, date=d

=== clean | no partition column at all, or only one constraint
r:select from t where sym=`a, size>500
s:select from t where date=2024.01.05

=== clean | the first constraint already names the partition column
r:select from t where (date=d) or sym=`a, date=2024.01.05

=== clean | a date column that is not tested, only read
r:select from t where sym=`a, date2=2024.01.05

=== QV002 | each over an atomic builtin (KDB-X, a million items: abs each 63 ms, abs under 1 ms)
r:abs each x
s:sqrt each y
u:not'[b]

=== QV002 | inside a lambda and a select
f:{[x] neg each x}
r:select n:null each p from t

=== QV002 | each over apply, and each in brackets (KDB-X: abs@'x and each[abs;x] are abs x, #2927)
r:abs@'x
s:each[abs;x]
u:each [neg;x]

=== clean | each before a bracket is applied to it first: abs each[-1 2] and abs@'[-1 2] are 'type on KDB-X, and a fix gave abs[-1 2] (#2929)
r:abs each[-1 2]
s:abs each [-1 2]
u:abs@'[-1 2]
v:each[abs;]

=== clean | an iterator on each is each's own: 'type on KDB-X, where the fix left abs':, null/ and not\ (#2930)
a:abs each':[x]
b:null each/[x]
c:not each\[01b]
d:neg each'[(1 2;3 4)]
e:abs each/: x
f:abs@':x

=== clean | each over what is not atomic
r:count each x
s:string each y
u:sum each z
v:first each w

=== clean | a name that ends in an atomic builtin's name, and a symbol
r:myabs each x
s:`abs
u:.my.neg each x

=== clean | abs alone
r:abs x

=== QV003 | a join to itself in a do loop (KDB-X: 10k, 20k, 40k passes 52, 205, 818 ms; with ,: 2.5, 5.5, 11 ms)
f:{r:(); do[n; r:r,til 10]; r}

=== QV003 | raze of itself in a while loop
f:{r:(); i:0; while[i<n; r:raze(r;g i); i+:1]; r}

=== QV003 | in a while's condition, which runs on every pass as the body does (KDB-X: 20k and 40k passes 36 and 106 ms; with ,: 5 ms, #2944)
h:{[n] r:(); i:0; while[n>count r:r,i; i+:1]; r}

=== clean | a do's count runs once, and a condition that gives a fresh value leaves the body joining to that
f:{[n] r:(); do[count r:r,n; r,:1]; r}
g:{[x] while[count r:f x; r:r,1; x-:1]; r}

=== clean | in a query's phrase `p:p,0` is the column `p` and then the column `0`, joined to nothing (q 5: columns p and x, #2925)
f:{[n;t] do[n; t:select p:p,0 by sym from t]; t}
g:{[n;t] r:(); do[n; r:exec p:p,0 from t]; r}
h:{[n;t] do[n; t:update p:p,0 from t where s:s,1]; t}

=== QV003 | a join in parentheses in a query, or to a query, is still a join
f:{[n;t] r:(); do[n; t:select from t where p in (r:r,n)]; r}
g:{[n;t] r:(); do[n; r:r,select from t]; r}

=== clean | appending in place, and raze each
f:{r:(); do[n; r,:til 10]; r}
g:{raze h each til n}

=== clean | a join to another name, or each-both
f:{r:(); do[n; s:r,til 10]; s}
g:{r:(); do[n; r:r,'x]; r}

=== clean | given a fresh value earlier in the same pass, so each pass joins to that
f:{while[null fd; d:g[]; if[not 99h=type d; d:()!()]; d:d,enlist[`a]!enlist 1; h d]}
g:{do[n; r:(); r:r,til 10; h r]}

=== clean | a lambda's own local, inside the loop body
f:{do[n; h {[r;x] r:r,x; r}[r0;1]]}

=== QV003 | a fresh value of another name does not hide the join
f:{r:(); do[n; s:(); r:r,til 10]; r}

=== clean | outside a loop
f:{[r] r:r,til 10; r}

=== clean | in the condition of the loop, not its body
f:{[r] while[count r:r,1; r:()]}

=== QV003 | once, in a loop inside a loop
f:{r:(); do[n; do[m; r:r,1]]; r}

=== QV001 | once, for a where under two templates
r:select max p by s from select from t where sym=`a, date=d
