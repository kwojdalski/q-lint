{
  "name": "q-lint",
  "displayName": "q-lint",
  "description": "Diagnostics for q/kdb+ source, from the q-lint language server",
  "icon": "icon.png",
  "version": "0.3.4",
  "publisher": "wojdalski",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:q"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "q",
        "aliases": [
          "q",
          "kdb+"
        ],
        "extensions": [
          ".q",
          ".k"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "q-lint",
      "properties": {
        "q-lint.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `qlinter` binary. Left empty, the extension uses the server it was packaged with, and falls back to looking up `qlinter` on `PATH` when it was packaged without one."
        },
        "q-lint.profile": {
          "type": "string",
          "enum": [
            "general",
            "uqf"
          ],
          "default": "general",
          "markdownDescription": "Rule profile. `uqf` adds this repository's own conventions on top of the general q rules."
        },
        "q-lint.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the traffic between VS Code and the server, for debugging the integration itself."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kwojdalski/q-lint.git"
  },
  "bugs": {
    "url": "https://github.com/kwojdalski/q-lint/issues"
  },
  "homepage": "https://github.com/kwojdalski/q-lint#readme"
}
