  "/:": { "examples": [{ "code": "1 2,/:10 20", "result": "(1 2 10;1 2 20)" }], "see": ["\\:", "each"] },
  "\\:": { "examples": [{ "code": "1 2,\\:10", "result": "(1 10;2 10)" }], "see": ["/:", "each"] },
  "/": { "examples": [{ "code": "+/[1 2 3]", "result": "6" }, { "code": "10+/1 2 3", "result": "16" }], "see": ["over", "\\"] },
  "\\": { "examples": [{ "code": "+\\[1 2 3]", "result": "1 3 6" }], "see": ["scan", "/"] }
}
