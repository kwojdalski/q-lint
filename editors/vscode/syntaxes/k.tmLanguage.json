{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "k",
  "scopeName": "source.k",
  "comment": "k, the language q is written in: the .k files q loads. Lexically q's: a `/` opens a comment at the start of a line or after whitespace and is an adverb after a value; a lone `/` opens a block a lone `\\` closes; a lone `\\` outside one ends the script; a line opening with `\\` is a system command. k has no named builtins and no q keywords, so it has no rules for them. Written by hand: there is no list to generate it from.",
  "patterns": [
    { "include": "#block-comment" },
    { "include": "#end-of-script" },
    { "include": "#system-command" },
    { "include": "#expression" }
  ],
  "repository": {
    "block-comment": {
      "name": "comment.block.k",
      "begin": "^/\\s*$",
      "end": "^\\\\\\s*$",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.k" } },
      "endCaptures": { "0": { "name": "punctuation.definition.comment.end.k" } }
    },
    "end-of-script": {
      "comment": "A lone backslash outside a block ends the script; q reads nothing after it.",
      "name": "comment.block.end-of-script.k",
      "begin": "^\\\\\\s*$",
      "end": "(?=A)(?!A)",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.k" } }
    },
    "system-command": {
      "patterns": [
        {
          "match": "^(\\\\d)\\s+(\\.[A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.other.system.k" },
            "2": { "name": "entity.name.namespace.k" }
          }
        },
        {
          "match": "^(\\\\[A-Za-z_12]\\w*|\\\\\\\\)(.*)$",
          "captures": {
            "1": { "name": "keyword.other.system.k" },
            "2": { "name": "string.unquoted.argument.k" }
          }
        }
      ]
    },
    "expression": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#symbol" },
        { "include": "#lambda" },
        { "include": "#number" },
        { "include": "#name" },
        { "include": "#adverb" },
        { "include": "#verb" },
        { "include": "#bracket" }
      ]
    },
    "comment": {
      "name": "comment.line.k",
      "begin": "(?:^|(?<=\\s))(/)",
      "end": "$",
      "beginCaptures": { "1": { "name": "punctuation.definition.comment.k" } }
    },
    "string": {
      "name": "string.quoted.double.k",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.k" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.k" } },
      "patterns": [
        { "match": "\\\\(?:[0-7]{3}|[nrt\"\\\\])", "name": "constant.character.escape.k" },
        { "match": "\\\\.", "name": "invalid.illegal.escape.k" }
      ]
    },
    "symbol": {
      "patterns": [
        {
          "comment": "A file or network handle: `:path/to/file, `:host:port. A minus is not in one: `:a-b is `:a minus b.",
          "match": "`:[A-Za-z0-9_.:/]*",
          "name": "constant.other.symbol.handle.k"
        },
        {
          "comment": "Past a colon a symbol takes slashes too: `a:b/c is one symbol.",
          "match": "`[A-Za-z0-9_.]*(?::[A-Za-z0-9_.:/]*)?",
          "name": "constant.other.symbol.k"
        }
      ]
    },
    "lambda": {
      "comment": "x, y and z are a lambda's implicit parameters only when it declares none: in {[a] x+a} x is a global. So a lambda with a parameter list, on one line or several, is told from one without.",
      "patterns": [
        {
          "name": "meta.function.lambda.k",
          "begin": "(\\{)\\s*(\\[)([^\\]]*)(\\])",
          "end": "\\}",
          "beginCaptures": {
            "1": { "name": "punctuation.section.function.begin.k" },
            "2": { "name": "punctuation.definition.parameters.begin.k" },
            "3": {
              "patterns": [
                { "match": "[A-Za-z][A-Za-z0-9_]*", "name": "variable.parameter.k" },
                { "match": ";", "name": "punctuation.separator.parameters.k" }
              ]
            },
            "4": { "name": "punctuation.definition.parameters.end.k" }
          },
          "endCaptures": { "0": { "name": "punctuation.section.function.end.k" } },
          "patterns": [
            { "include": "#block-comment" },
            { "include": "#end-of-script" },
            { "include": "#comment" },
            { "include": "#string" },
            { "include": "#symbol" },
            { "include": "#lambda" },
            { "include": "#number" },
            { "include": "#name" },
            { "include": "#adverb" },
            { "include": "#verb" },
            { "include": "#bracket" }
          ]
        },
        {
          "comment": "A parameter list that closes on a later line.",
          "name": "meta.function.lambda.k",
          "begin": "(\\{)\\s*(\\[)",
          "end": "\\}",
          "beginCaptures": {
            "1": { "name": "punctuation.section.function.begin.k" },
            "2": { "name": "punctuation.definition.parameters.begin.k" }
          },
          "endCaptures": { "0": { "name": "punctuation.section.function.end.k" } },
          "patterns": [
            {
              "begin": "\\G",
              "end": "\\]",
              "endCaptures": { "0": { "name": "punctuation.definition.parameters.end.k" } },
              "patterns": [
                { "include": "#comment" },
                { "match": "[A-Za-z][A-Za-z0-9_]*", "name": "variable.parameter.k" },
                { "match": ";", "name": "punctuation.separator.parameters.k" }
              ]
            },
            { "include": "#block-comment" },
            { "include": "#end-of-script" },
            { "include": "#comment" },
            { "include": "#string" },
            { "include": "#symbol" },
            { "include": "#lambda" },
            { "include": "#number" },
            { "include": "#name" },
            { "include": "#adverb" },
            { "include": "#verb" },
            { "include": "#bracket" }
          ]
        },
        {
          "name": "meta.function.lambda.k",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.function.begin.k" } },
          "endCaptures": { "0": { "name": "punctuation.section.function.end.k" } },
          "patterns": [
            { "include": "#block-comment" },
            { "include": "#end-of-script" },
            { "include": "#comment" },
            { "include": "#string" },
            { "include": "#symbol" },
            { "include": "#lambda" },
            { "include": "#number" },
            {
              "comment": "x, y and z are a lambda's implicit parameters.",
              "match": "(?<![A-Za-z0-9_.`])[xyz](?![A-Za-z0-9_])",
              "name": "variable.language.implicit.k"
            },
            { "include": "#name" },
            { "include": "#adverb" },
            { "include": "#verb" },
            { "include": "#bracket" }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "comment": "Timestamp, datetime, date, month, timespan and time literals.",
          "name": "constant.numeric.temporal.k",
          "match": "(?<![A-Za-z0-9_.`])(?:\\d{4}\\.\\d{2}\\.\\d{2}[DT](?:\\d{2}(?::\\d{2}(?::\\d{2}(?:\\.\\d*)?)?)?)?[pz]?|\\d{4}\\.\\d{2}(?:\\.\\d{2}[dpz]?|m)|\\d+D(?:\\d{2}(?::\\d{2}(?::\\d{2}(?:\\.\\d*)?)?)?)?n?|\\d{2,}:\\d{2}(?::\\d{2}(?:\\.\\d*)?)?[tuvn]?)(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.language.null.k",
          "match": "(?<![A-Za-z0-9_.`])-?0(?:[Nn][ghijefcpmdznuvt]?|[Ww][hijefcpmdznuvt]?)(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.language.boolean.k",
          "match": "(?<![A-Za-z0-9_.`])[01]+b(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.byte.k",
          "match": "(?<![A-Za-z0-9_.`])0x[0-9a-fA-F]*(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.k",
          "match": "(?<![A-Za-z0-9_.`])(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?[hijefcnuvtp]?(?![A-Za-z0-9_])"
        }
      ]
    },
    "name": {
      "match": "(?<![A-Za-z0-9_.`])(\\.[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)*(?=\\.))?(\\.?[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)*)(?![A-Za-z0-9_])",
      "captures": {
        "1": { "name": "entity.name.namespace.k" },
        "2": { "name": "variable.other.k" }
      }
    },
    "adverb": {
      "comment": "each-prior, each-right and each-left before each, over and scan; a `/` reaching here is not a comment.",
      "name": "keyword.operator.adverb.k",
      "match": "':|/:|\\\\:|'|/|\\\\"
    },
    "verb": {
      "patterns": [
        { "name": "keyword.operator.assignment.k", "match": "(?<![-+*%!&|^=<>~,#_$?@.:])[-+*%!&|^=<>~,#_$?@.]?:" },
        { "name": "keyword.operator.k", "match": "[-+*%!&|^=<>~,#_$?@.:]" },
        { "name": "punctuation.separator.statement.k", "match": ";" }
      ]
    },
    "bracket": {
      "patterns": [
        { "name": "punctuation.section.brackets.k", "match": "[\\[\\]]" },
        { "name": "punctuation.section.parens.k", "match": "[()]" },
        { "name": "punctuation.section.braces.k", "match": "\\}" }
      ]
    }
  }
}
