{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "q",
  "scopeName": "source.q",
  "comment": "Generated by scripts/q_grammar.py from src/reserved.json - edit that, not this.",
  "patterns": [
    {
      "include": "#block-comment"
    },
    {
      "include": "#end-of-script"
    },
    {
      "include": "#foreign"
    },
    {
      "include": "#system-command"
    },
    {
      "include": "#prompt"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "block-comment": {
      "name": "comment.block.q",
      "begin": "^/\\s*$",
      "end": "^\\\\\\s*$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.q"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.q"
        }
      },
      "patterns": [
        {
          "include": "#qdoc"
        }
      ]
    },
    "end-of-script": {
      "comment": "A lone backslash outside a block ends the script; q reads nothing after it.",
      "name": "comment.block.end-of-script.q",
      "begin": "^\\\\\\s*$",
      "end": "(?=A)(?!A)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.q"
        }
      }
    },
    "foreign": {
      "comment": "p) and k) lines, and the indented lines that continue them.",
      "patterns": [
        {
          "name": "meta.embedded.block.python.q",
          "begin": "^(p\\))",
          "end": "^(?=\\S|\\s*$)",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.language-prefix.q"
            }
          },
          "contentName": "source.python",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "name": "meta.embedded.block.k.q",
          "begin": "^(k\\))",
          "end": "^(?=\\S|\\s*$)",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.language-prefix.q"
            }
          },
          "contentName": "string.unquoted.k.q"
        }
      ]
    },
    "system-command": {
      "patterns": [
        {
          "match": "^(\\\\d)\\s+(\\.[A-Za-z0-9_.]*)",
          "captures": {
            "1": {
              "name": "keyword.other.system.q"
            },
            "2": {
              "name": "entity.name.namespace.q"
            }
          }
        },
        {
          "match": "^(\\\\[A-Za-z_12]\\w*|\\\\\\\\)(.*)$",
          "captures": {
            "1": {
              "name": "keyword.other.system.q"
            },
            "2": {
              "name": "string.unquoted.argument.q"
            }
          }
        }
      ]
    },
    "prompt": {
      "match": "^q\\)",
      "name": "punctuation.separator.prompt.q"
    },
    "expression": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#symbol"
        },
        {
          "include": "#lambda"
        },
        {
          "include": "#number"
        },
        {
          "include": "#definition"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#system-namespace"
        },
        {
          "include": "#builtin"
        },
        {
          "include": "#name"
        },
        {
          "include": "#operator"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "comment": "qdoc: `///` opens a documentation block and `//` continues it.",
          "name": "comment.line.documentation.q",
          "begin": "(?:^|(?<=\\s))(//+)",
          "end": "$",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.comment.q"
            }
          },
          "patterns": [
            {
              "include": "#qdoc"
            }
          ]
        },
        {
          "name": "comment.line.q",
          "begin": "(?:^|(?<=\\s))(/)",
          "end": "$",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.comment.q"
            }
          },
          "patterns": [
            {
              "include": "#qdoc"
            }
          ]
        }
      ]
    },
    "qdoc": {
      "patterns": [
        {
          "match": "(@param)\\s+([A-Za-z][A-Za-z0-9_]*)(?:\\s+(\\{[^}]*\\}))?",
          "captures": {
            "1": {
              "name": "storage.type.class.qdoc.q"
            },
            "2": {
              "name": "variable.parameter.qdoc.q"
            },
            "3": {
              "name": "entity.name.type.qdoc.q"
            }
          }
        },
        {
          "match": "(@[A-Za-z]+)(?:\\s+(\\{[^}]*\\}))?",
          "captures": {
            "1": {
              "name": "storage.type.class.qdoc.q"
            },
            "2": {
              "name": "entity.name.type.qdoc.q"
            }
          }
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.q",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.q"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.q"
        }
      },
      "patterns": [
        {
          "match": "\\\\(?:[0-7]{3}|[nrt\"\\\\])",
          "name": "constant.character.escape.q"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.q"
        }
      ]
    },
    "symbol": {
      "patterns": [
        {
          "comment": "A file or network handle: `:path/to/file, `:host:port.",
          "match": "`:[A-Za-z0-9_.:/\\-]*",
          "name": "constant.other.symbol.handle.q"
        },
        {
          "match": "`[A-Za-z0-9_.:]*",
          "name": "constant.other.symbol.q"
        }
      ]
    },
    "lambda": {
      "name": "meta.function.lambda.q",
      "begin": "(\\{)\\s*(?:(\\[)([^\\]]*)(\\]))?",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.function.begin.q"
        },
        "2": {
          "name": "punctuation.definition.parameters.begin.q"
        },
        "3": {
          "patterns": [
            {
              "match": "[A-Za-z][A-Za-z0-9_]*",
              "name": "variable.parameter.q"
            },
            {
              "match": ";",
              "name": "punctuation.separator.parameters.q"
            }
          ]
        },
        "4": {
          "name": "punctuation.definition.parameters.end.q"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.function.end.q"
        }
      },
      "patterns": [
        {
          "include": "#block-comment"
        },
        {
          "include": "#end-of-script"
        },
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#symbol"
        },
        {
          "include": "#lambda"
        },
        {
          "include": "#number"
        },
        {
          "include": "#definition"
        },
        {
          "comment": "x, y and z are a lambda's implicit parameters.",
          "match": "(?<![A-Za-z0-9_.`])[xyz](?![A-Za-z0-9_])",
          "name": "variable.language.implicit.q"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#system-namespace"
        },
        {
          "include": "#builtin"
        },
        {
          "include": "#name"
        },
        {
          "include": "#operator"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.temporal.q",
          "match": "(?<![A-Za-z0-9_.`])(?:\\d{4}\\.\\d{2}\\.\\d{2}[DT](?:\\d{2}(?::\\d{2}(?::\\d{2}(?:\\.\\d*)?)?)?)?[pz]?|\\d{4}\\.\\d{2}(?:\\.\\d{2}d?|m)|\\d+D(?:\\d{2}(?::\\d{2}(?::\\d{2}(?:\\.\\d*)?)?)?)?n?|\\d{2}:\\d{2}(?::\\d{2}(?:\\.\\d{3})?)?[tuv]?)(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.language.null.q",
          "match": "(?<![A-Za-z0-9_.`])-?0[NnWw][ghijefcspmdznuvt]?(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.language.boolean.q",
          "match": "(?<![A-Za-z0-9_.`])[01]+b(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.byte.q",
          "match": "(?<![A-Za-z0-9_.`])0x[0-9a-fA-F]*(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.q",
          "match": "(?<![A-Za-z0-9_.`])(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:e[+-]?\\d+)?[hijefcnuvt]?(?![A-Za-z0-9_])"
        }
      ]
    },
    "definition": {
      "patterns": [
        {
          "comment": "A name assigned a lambda: f:{...} or .ns.f::{...}.",
          "match": "(?<![A-Za-z0-9_.`])(\\.?[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)*)\\s*(::?)(?=\\s*\\{)",
          "captures": {
            "1": {
              "name": "entity.name.function.q"
            },
            "2": {
              "name": "keyword.operator.assignment.q"
            }
          }
        },
        {
          "comment": "Any other assignment, a:1 or a::1, but not an iterator such as /: or \\:.",
          "match": "(?<![A-Za-z0-9_.`])(\\.?[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)*)\\s*(::?)(?![:/\\\\'])",
          "captures": {
            "1": {
              "name": "variable.other.definition.q"
            },
            "2": {
              "name": "keyword.operator.assignment.q"
            }
          }
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.q",
          "match": "(?<![A-Za-z0-9_.`])(?:while|do|if)(?![A-Za-z0-9_])"
        },
        {
          "name": "keyword.control.conditional.q",
          "match": "\\$(?=\\[)"
        },
        {
          "name": "keyword.other.qsql.q",
          "match": "(?<![A-Za-z0-9_.`])(?:delete|select|update|where|exec|from|by)(?![A-Za-z0-9_])"
        }
      ]
    },
    "system-namespace": {
      "comment": "The namespaces q reserves for itself: .q .Q .z .h .j .o and their members.",
      "name": "support.function.system.q",
      "match": "(?<![A-Za-z0-9_.`])\\.[qQzhjo](?:\\.[A-Za-z0-9_]+)*(?![A-Za-z0-9_])"
    },
    "builtin": {
      "name": "support.function.builtin.q",
      "match": "(?<![A-Za-z0-9_.`])(?:reciprocal|distinct|ceiling|reverse|sublist|ungroup|deltas|differ|enlist|except|getenv|hclose|hcount|insert|mcount|ratios|rotate|setenv|signum|string|system|tables|upsert|within|xgroup|count|cross|dsave|fills|first|fkeys|floor|group|gtime|hopen|idesc|inter|lower|ltime|ltrim|parse|peach|prior|read0|read1|reval|rload|rsave|rtrim|union|upper|value|views|xcols|xdesc|xprev|xrank|acos|ajf0|asin|asof|atan|attr|avgs|binr|cols|desc|each|eval|exit|flip|hdel|hsym|iasc|keys|last|like|load|mavg|maxs|mdev|meta|mins|mmax|mmin|msum|next|null|over|prds|prev|rand|rank|raze|save|scan|scov|sdev|show|sqrt|sums|svar|trim|type|view|wavg|wsum|xasc|xbar|xcol|xexp|xkey|xlog|abs|aj0|ajf|all|and|any|asc|avg|bin|cor|cos|cov|csv|cut|dev|div|ema|exp|fby|get|ijf|inv|key|ljf|log|lsq|max|md5|med|min|mmu|mod|neg|not|prd|set|sin|ssr|sum|tan|til|ujf|use|var|wj1|aj|ej|ij|in|lj|or|pj|ss|sv|uj|vs|wj|ww)(?![A-Za-z0-9_])"
    },
    "name": {
      "name": "variable.other.q",
      "match": "(?<![A-Za-z0-9_.`])\\.?[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)*(?![A-Za-z0-9_])"
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.iterator.q",
          "match": "[/\\\\']:|':|'|/|\\\\"
        },
        {
          "name": "keyword.operator.q",
          "match": "[-+*%!&|^=<>~,#_$?@.:]"
        },
        {
          "name": "punctuation.separator.statement.q",
          "match": ";"
        }
      ]
    }
  }
}
