{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "q console",
  "scopeName": "source.q-console",
  "comment": "The q-lint: query output channel, as src/query.ts's render and src/live.ts write it: a `# process (n ms)` header, ` - 'error` after it on a failure, the query as `q) ` lines when it is included, then q's own console text (.Q.S) or the error and its .Q.sbt backtrace. Every rule is one line: the channel is appended to, so no state may carry from one answer into the next.",
  "patterns": [
    { "include": "#header" },
    { "include": "#query" },
    { "include": "#error" },
    { "include": "#frame" },
    { "include": "#caret" },
    { "include": "#separator" },
    { "include": "#value" }
  ],
  "repository": {
    "header": {
      "patterns": [
        {
          "comment": "# rdb (12 ms), and on a failure  - 'type after it.",
          "match": "^(#) (.+) \\((\\d+) (ms)\\)(?:( - )('.*))?$",
          "name": "markup.heading.query.q-console",
          "captures": {
            "1": { "name": "punctuation.definition.heading.q-console" },
            "2": { "name": "entity.name.tag.process.q-console" },
            "3": { "name": "constant.numeric.time.q-console" },
            "4": { "name": "keyword.other.unit.q-console" },
            "6": { "name": "invalid.illegal.error.q-console" }
          }
        },
        {
          "comment": "# rdb - failed: why, # rdb - aborted: the query never answered, or # rdb - timed out after 5 s: it ran past q-lint.query.timeout.",
          "match": "^(#) (.+?) - ((?:aborted|failed|timed out after \\d+(?:\\.\\d+)? s)\\b.*)$",
          "name": "markup.heading.query.q-console",
          "captures": {
            "1": { "name": "punctuation.definition.heading.q-console" },
            "2": { "name": "entity.name.tag.process.q-console" },
            "3": { "name": "invalid.illegal.error.q-console" }
          }
        }
      ]
    },
    "query": {
      "comment": "The query, included before its answer.",
      "match": "^(q\\))(.*)$",
      "captures": {
        "1": { "name": "punctuation.separator.prompt.q-console" },
        "2": { "name": "meta.embedded.line.q", "patterns": [{ "include": "source.q" }] }
      }
    },
    "error": {
      "match": "^'.*$",
      "name": "invalid.illegal.error.q-console"
    },
    "frame": {
      "comment": "A backtrace frame: [2]  file.q:4: code, or [0]  code for the query itself.",
      "match": "^\\s*(\\[\\d+\\])\\s+(?:(\\S+?:\\d+:)(?=\\s))?(.*)$",
      "captures": {
        "1": { "name": "keyword.control.frame.q-console" },
        "2": { "name": "entity.name.type.location.q-console" },
        "3": { "name": "meta.embedded.line.q", "patterns": [{ "include": "source.q" }] }
      }
    },
    "caret": {
      "comment": "The line under a frame pointing at where it failed.",
      "match": "^\\s*(\\^)\\s*$",
      "captures": { "1": { "name": "invalid.illegal.caret.q-console" } }
    },
    "separator": {
      "comment": "A table's rule under its header; a keyed table's has a | between key and value columns.",
      "match": "^(-+)(?:(\\|)( )(-+))?\\s*$",
      "captures": {
        "1": { "name": "comment.line.separator.q-console" },
        "2": { "name": "keyword.other.key.q-console" },
        "4": { "name": "comment.line.separator.q-console" }
      }
    },
    "value": {
      "patterns": [
        {
          "comment": "A dictionary's or keyed table's key from its value.",
          "match": "\\|(?= |$)",
          "name": "keyword.other.key.q-console"
        },
        {
          "name": "string.quoted.double.q-console",
          "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
          "captures": { "0": { "patterns": [{ "match": "\\\\(?:[0-3][0-7]{2}|[nrt\"\\\\/])", "name": "constant.character.escape.q-console" }] } }
        },
        {
          "name": "constant.other.symbol.handle.q-console",
          "match": "`:[A-Za-z0-9_.:/\\-]*"
        },
        {
          "comment": "Past a colon a symbol takes slashes too: `a:b/c is one symbol.",
          "name": "constant.other.symbol.q-console",
          "match": "`[A-Za-z0-9_.]*(?::[A-Za-z0-9_.:/]*)?"
        },
        {
          "comment": "A guid, as q prints one: before the numbers, whose rules would colour its all-digit groups.",
          "name": "constant.other.guid.q-console",
          "match": "(?<![A-Za-z0-9_.`-])[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![A-Za-z0-9_-])"
        },
        {
          "name": "constant.numeric.temporal.q-console",
          "match": "(?<![A-Za-z0-9_.`])(?:\\d{4}\\.\\d{2}\\.\\d{2}[DT](?:\\d{2}(?::\\d{2}(?::\\d{2}(?:\\.\\d*)?)?)?)?[pz]?|\\d{4}\\.\\d{2}(?:\\.\\d{2}d?|m)|-?\\d+D(?:\\d{2}(?::\\d{2}(?::\\d{2}(?:\\.\\d*)?)?)?)?n?|-?\\d{2}:\\d{2}(?::\\d{2}(?:\\.\\d+)?)?[tuv]?)(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.language.null.q-console",
          "match": "(?<![A-Za-z0-9_.`])-?0[NnWw][ghijefcspmdznuvt]?(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.language.boolean.q-console",
          "match": "(?<![A-Za-z0-9_.`])[01]+b(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.byte.q-console",
          "match": "(?<![A-Za-z0-9_.`])0x[0-9a-fA-F]*(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.q-console",
          "match": "(?<![A-Za-z0-9_.`])-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:e[+-]?\\d+)?[hijefcnuvt]?(?![A-Za-z0-9_])"
        }
      ]
    }
  }
}
